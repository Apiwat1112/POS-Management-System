<!DOCTYPE html>
<html lang="th" data-bs-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>แก้ไขข้อมูลพนักงาน - POS System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>
</head>

<body>
    <%- include('../navbar') %>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="glass-panel p-4 p-md-5 animate__animated animate__fadeIn">
                    <div class="text-center mb-4">
                        <div class="display-6 text-warning mb-2"><i class="bi bi-pencil-square"></i></div>
                        <h3 class="fw-bold text-gradient">แก้ไขข้อมูลพนักงาน</h3>
                        <p class="text-muted small">ปรับปรุงข้อมูลพนักงานหรือรีเซ็ตรหัสผ่าน</p>
                    </div>

                    <form method="POST" action="/employees/edit/<%= employee._id %>">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">ชื่อ - นามสกุล</label>
                            <input class="form-control" name="name" value="<%= employee.name %>" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">อีเมล</label>
                            <input class="form-control" name="email" type="email" value="<%= employee.email %>" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">ชื่อผู้ใช้งาน (Username)</label>
                            <input class="form-control" name="username" value="<%= employee.username %>" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">รหัสผ่านใหม่ (ถ้าต้องการเปลี่ยน)</label>
                            <input class="form-control" name="password" type="password" placeholder="เว้นว่างไว้หากไม่ต้องการเปลี่ยน">
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted">ตำแหน่ง / สิทธิ์การใช้งาน</label>
                            <select class="form-select" name="role">
                                <option value="employee" <%= employee.role === 'employee' ? 'selected' : '' %>>พนักงานทั่วไป (Employee)</option>
                                <option value="owner" <%= employee.role === 'owner' ? 'selected' : '' %>>เจ้าของร้าน (Owner)</option>
                            </select>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button class="btn btn-warning rounded-pill py-2 fw-bold shadow-sm">
                                <i class="bi bi-save-fill me-2"></i> บันทึกการแก้ไข
                            </button>
                            <a href="/employees" class="btn btn-link text-muted small text-decoration-none">ยกเลิกและกลับ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>