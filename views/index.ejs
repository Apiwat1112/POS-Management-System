<!DOCTYPE html>
<html lang="th" data-bs-theme="dark">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>POS System - Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>

        body {
            font-family: 'Noto Sans Thai', 'Sarabun', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        .dashboard-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* --- Welcome Header --- */
        .welcome-header {
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .welcome-header h2 {
            font-weight: 700;
            font-size: 1.8rem;
            margin: 0;
            background: linear-gradient(135deg, var(--bs-primary), var(--bs-link-hover-color));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .welcome-header p {
            color: var(--muted);
            margin: 5px 0 0 0;
            font-size: 1rem;
        }

        .btn-pos {
            background: var(--accent);
            color: #fff;
            border: none;
            padding: 10px 24px;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all .2s;
            box-shadow: 0 4px 15px var(--accent-glow);
        }

        .btn-pos:hover {
            background: #4f46e5;
            transform: translateY(-2px);
            color: #fff;
        }

        /* --- Stat Cards --- */
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--card-radius);
            padding: 24px;
            position: relative;
            overflow: hidden;
            transition: all .3s;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
            opacity: 0.4;
            transform: translate(30%, -30%);
            transition: opacity .3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .stat-card:hover::before {
            opacity: 0.8;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 16px;
        }

        .stat-card.sales .stat-icon {
            background: rgba(34, 197, 94, 0.15);
            color: var(--green);
        }
        .stat-card.orders .stat-icon {
            background: rgba(99, 102, 241, 0.15);
            color: var(--accent);
        }
        .stat-card.products .stat-icon {
            background: rgba(245, 158, 11, 0.15);
            color: #fbbf24;
        }
        .stat-card.members .stat-icon {
            background: rgba(236, 72, 153, 0.15);
            color: #f472b6;
        }

        .stat-title {
            color: var(--muted);
            font-size: 0.9rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text);
            margin: 0;
        }

        /* --- Recent Activity --- */
        .section-header {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-header i {
            color: var(--accent);
        }

        .dashboard-table {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--card-radius);
            overflow: hidden;
        }

        .table-dark-custom {
            width: 100%;
            margin: 0;
            color: var(--text);
        }

        .table-dark-custom th {
            background: var(--surface2);
            padding: 16px 20px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border);
        }

        .table-dark-custom td {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
            font-size: 0.95rem;
        }

        .table-dark-custom tr:last-child td {
            border-bottom: none;
        }

        .table-dark-custom tbody tr {
            transition: background .2s;
        }

        .table-dark-custom tbody tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .badge-payment {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-cash { background: rgba(34, 197, 94, 0.15); color: var(--green); border: 1px solid rgba(34, 197, 94, 0.3); }
        .badge-transfer { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
        .badge-promptpay { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }

        .empty-state {
            padding: 40px;
            text-align: center;
            color: var(--muted);
        }

    </style>

    <link rel="stylesheet" href="/css/theme.css">

    <script src="/js/theme.js"></script>
</head>

<body>
    <%- include('navbar') %>

    <div class="dashboard-container">
        <!-- Header -->
        <div class="welcome-header">
            <div>
                <h2>สวัสดี, <%= user ? user.name : 'ผู้ดูแลระบบ' %> 👋</h2>
                <p>ยินดีต้อนรับสู่ระบบจัดการร้านค้า (POS)</p>
            </div>
            <a href="/sales" class="btn-pos">
                <i class="bi bi-shop"></i> ไปหน้าขายสินค้า
            </a>
        </div>

        <!-- Metrics -->
        <div class="stat-grid">
            <div class="stat-card sales">
                <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div class="stat-title">ยอดขายวันนี้</div>
                <div class="stat-value">฿<%= Number(metrics.sumSalesToday).toLocaleString() %></div>
            </div>
            
            <div class="stat-card orders">
                <div class="stat-icon"><i class="bi bi-receipt"></i></div>
                <div class="stat-title">จำนวนบิลวันนี้</div>
                <div class="stat-value"><%= metrics.ordersToday %> <span style="font-size: 1rem; color: var(--muted); font-weight: normal;">รายการ</span></div>
            </div>

            <div class="stat-card products">
                <div class="stat-icon"><i class="bi bi-box-seam"></i></div>
                <div class="stat-title">สินค้าทั้งหมด</div>
                <div class="stat-value"><%= metrics.totalProducts %> <span style="font-size: 1rem; color: var(--muted); font-weight: normal;">รายการ</span></div>
            </div>

            <div class="stat-card members">
                <div class="stat-icon"><i class="bi bi-people"></i></div>
                <div class="stat-title">สมาชิกลูกค้า</div>
                <div class="stat-value"><%= metrics.totalMembers %> <span style="font-size: 1rem; color: var(--muted); font-weight: normal;">คน</span></div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="section-header">
            <i class="bi bi-clock-history"></i> รายการขายล่าสุด
        </div>

        <div class="dashboard-table">
            <table class="table-dark-custom">
                <thead>
                    <tr>
                        <th>เวลา</th>
                        <th>เลขที่รายการ</th>
                        <th>ลูกค้า</th>
                        <th>พนักงาน</th>
                        <th>การชำระเงิน</th>
                        <th class="text-end">ยอดสุทธิ</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recentSales.length > 0) { %>
                        <% recentSales.forEach(sale => { %>
                            <tr>
                                <td><%= new Date(sale.createdAt).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) %> น.</td>
                                <td><span style="font-family: monospace; color: var(--muted);"><%= sale._id.toString().substring(18) %></span></td>
                                <td>
                                    <% if (sale.member) { %>
                                        <i class="bi bi-person-fill text-muted me-1"></i> <%= sale.member.name %>
                                    <% } else { %>
                                        <span class="text-muted">- ลูกค้าทั่วไป -</span>
                                    <% } %>
                                </td>
                                <td><%= sale.employee ? sale.employee.name : '-' %></td>
                                <td>
                                    <% if(sale.paymentMethod === 'cash') { %>
                                        <span class="badge-payment badge-cash">เงินสด</span>
                                    <% } else if(sale.paymentMethod === 'transfer') { %>
                                        <span class="badge-payment badge-transfer">โอนเงิน</span>
                                    <% } else { %>
                                        <span class="badge-payment badge-promptpay">พร้อมเพย์</span>
                                    <% } %>
                                </td>
                                <td class="text-end fw-bold" style="color: var(--green);">
                                    ฿<%= Number(sale.total).toLocaleString(undefined, { minimumFractionDigits: 2 }) %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="bi bi-inbox fs-2 mb-2"></i>
                                    <p class="mb-0">ยังไม่มีรายการขาย</p>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>