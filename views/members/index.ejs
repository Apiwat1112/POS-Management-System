<!DOCTYPE html>
<html lang="th" data-bs-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>สมาชิก - POS System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>
</head>

<body>
    <%- include('../navbar') %>

    <div class="container mt-5">
        <div class="glass-panel p-4 animate__animated animate__fadeIn">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-0 text-gradient">รายชื่อสมาชิก</h3>
                    <p class="text-muted small mb-0">จัดการข้อมูลลูกค้าและแต้มสะสม</p>
                </div>
                <a href="/members/add" class="btn btn-primary d-flex align-items-center gap-2 rounded-pill px-4 shadow-sm">
                    <i class="bi bi-person-plus-fill"></i> เพิ่มสมาชิก
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr class="text-uppercase small fw-bold text-muted border-bottom">
                            <th class="ps-0 py-3">ชื่อ - นามสกุล</th>
                            <th class="py-3">เบอร์โทรศัพท์</th>
                            <th class="py-3">แต้มสะสม</th>
                            <th class="text-end pe-0 py-3">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (members && members.length > 0) { %>
                            <% members.forEach(m => { %>
                            <tr>
                                <td class="ps-0">
                                    <div class="fw-bold text-inherit"><%= m.name %></div>
                                </td>
                                <td class="text-inherit"><%= m.phone %></td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill">
                                        <i class="bi bi-star-fill me-1"></i> <%= m.point %> แต้ม
                                    </span>
                                </td>
                                <td class="text-end pe-0">
                                    <div class="btn-group">
                                        <a href="/members/edit/<%= m._id %>" class="btn btn-outline-warning btn-sm px-3 rounded-pill me-2">
                                            <i class="bi bi-pencil-square"></i> แก้ไข
                                        </a>
                                        <form action="/members/delete/<%= m._id %>" method="POST" style="display:inline" onsubmit="return confirm('ยืนยันการลบสมาชิกคนนี้?')">
                                            <button class="btn btn-outline-danger btn-sm px-3 rounded-pill">
                                                <i class="bi bi-trash-fill"></i> ลบ
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-people display-4 d-block mb-3 opacity-25"></i>
                                    ยังไม่มีข้อมูลสมาชิก
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>