<!DOCTYPE html>
<html lang="th" data-bs-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>เพิ่มสมาชิก - POS System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>
</head>

<body>
    <%- include('../navbar') %>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="glass-panel p-4 p-md-5 animate__animated animate__fadeIn">
                    <div class="text-center mb-4">
                        <div class="display-6 text-primary mb-2"><i class="bi bi-person-plus-fill"></i></div>
                        <h3 class="fw-bold text-gradient">ลงทะเบียนสมาชิกใหม่</h3>
                        <p class="text-muted small">บันทึกข้อมูลลูกค้าเพื่อสะสมแต้มและรับสิทธิพิเศษ</p>
                    </div>

                    <form method="POST" action="/members/add">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">ชื่อ - นามสกุล</label>
                            <input class="form-control" name="name" placeholder="ระบุชื่อลูกค้า" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">เบอร์โทรศัพท์</label>
                            <input class="form-control" name="phone" placeholder="ตัวอย่าง: 0812345678" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted">แต้มสะสมเริ่มต้น</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent text-muted"><i class="bi bi-star-fill"></i></span>
                                <input class="form-control" name="point" type="number" value="0">
                            </div>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary rounded-pill py-2 fw-bold shadow-sm">
                                <i class="bi bi-person-check-fill me-2"></i> ยืนยันการลงทะเบียน
                            </button>
                            <a href="/members" class="btn btn-link text-muted small text-decoration-none">ยกเลิกและกลับ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>