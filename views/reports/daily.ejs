<!DOCTYPE html>
<html lang="th" data-bs-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>รายงานยอดขายรายวัน | POS System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>

    <style>
        .dashboard-header {
            background: linear-gradient(135deg, var(--bs-primary), var(--bs-link-hover-color));
            color: white;
            padding: 40px 0;
            margin-bottom: 30px;
            box-shadow: 0 4px 20px rgba(99, 102, 241, 0.2);
            border-radius: 0 0 24px 24px;
        }

        .summary-card {
            background: var(--surface);
            backdrop-filter: var(--glass-blur);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid var(--surface-border);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            transition: transform 0.2s, box-shadow 0.2s;
            height: 100%;
            display: flex;
            align-items: center;
        }

        .summary-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            border-color: var(--bs-primary);
        }

        .summary-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin-right: 20px;
            flex-shrink: 0;
        }

        .icon-sales { background: rgba(99, 102, 241, 0.1); color: var(--bs-primary); }
        .icon-profit { background: rgba(16, 185, 129, 0.1); color: var(--green); }
        .icon-orders { background: rgba(139, 92, 246, 0.1); color: var(--amber); }

        .summary-info h5 {
            font-size: 0.85rem;
            color: var(--bs-body-color);
            opacity: 0.7;
            margin-bottom: 5px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .summary-info h3 {
            font-size: 1.5rem;
            color: var(--bs-body-color);
            margin: 0;
            font-weight: 700;
        }

        .date-picker-form {
            background: var(--surface);
            padding: 12px 20px;
            border-radius: 50px;
            border: 1px solid var(--surface-border);
            display: inline-flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .table-card {
            background: var(--surface);
            border-radius: 16px;
            border: 1px solid var(--surface-border);
            overflow: hidden;
            margin-bottom: 40px;
        }

        .table-header-custom {
            background: rgba(0, 0, 0, 0.05);
            color: var(--bs-body-color);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
        }

        .item-list {
            margin: 0;
            padding-left: 18px;
            font-size: 0.85rem;
            color: var(--bs-body-color);
            opacity: 0.8;
        }

        .badge-profit {
            background-color: var(--green);
            background-opacity: 0.1;
            color: var(--green);
            padding: 6px 14px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.85rem;
            border: 1px solid var(--green);
            border-opacity: 0.2;
        }
        
        [data-bs-theme="dark"] .badge-profit {
            background: rgba(34, 197, 94, 0.1);
        }
        [data-bs-theme="light"] .badge-profit {
            background: rgba(16, 185, 129, 0.1);
        }

        .payment-badge {
            font-size: 0.75rem;
            padding: 6px 12px;
            border-radius: 50px;
            font-weight: 600;
            border: 1px solid currentColor;
        }

        .payment-cash { color: var(--blue); background: rgba(59, 130, 246, 0.1); }
        .payment-transfer { color: var(--amber); background: rgba(245, 158, 11, 0.1); }
        .payment-promptpay { color: #d946ef; background: rgba(217, 70, 239, 0.1); }

    </style>
</head>

<body>
    <%- include('../navbar') %>

    <div class="dashboard-header animate__animated animate__fadeInDown">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-4">
            <div>
                <h2 class="mb-1 fw-bold"><i class="bi bi-bar-chart-fill me-2"></i>รายงานสรุปยอดขายรายวัน</h2>
                <p class="mb-0 opacity-75">ติดตามประสิทธิภาพการขายและวิเคราะห์กำไรขั้นต้น</p>
            </div>
            
            <form action="/reports/daily" method="GET" class="date-picker-form">
                <label for="date" class="form-label mb-0 fw-bold small">เลือกวันที่:</label>
                <input type="date" id="date" name="date" class="form-control form-control-sm border-0 bg-transparent text-inherit fw-bold" style="width: 140px;" 
                       value="<%= selectedDate.toISOString().split('T')[0] %>">
                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                    <i class="bi bi-arrow-right-circle"></i>
                </button>
            </form>
        </div>
    </div>

    <div class="container py-4">
        <!-- Summary Cards -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="summary-card">
                    <div class="summary-icon icon-sales">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <div class="summary-info">
                        <h5>ยอดขายสุทธิรวม</h5>
                        <h3 class="text-gradient">฿ <%= Number(summary.totalSales).toLocaleString('th-TH', { minimumFractionDigits: 2 }) %></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="summary-card">
                    <div class="summary-icon icon-profit">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                    <div class="summary-info">
                        <h5>กำไรขั้นต้นประมาณการ</h5>
                        <h3 style="color: var(--green)">฿ <%= Number(summary.totalProfit).toLocaleString('th-TH', { minimumFractionDigits: 2 }) %></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="summary-card">
                    <div class="summary-icon icon-orders">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <div class="summary-info">
                        <h5>จำนวนรายการขาย</h5>
                        <h3><%= summary.totalOrders %> <span class="fs-6 opacity-50 fw-normal">รายการ</span></h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sales History Table -->
        <div class="table-card animate__animated animate__fadeInUp">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-opacity-10 bg-dark">
                <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2"></i>ประวัติรายการขาย</h5>
                <span class="badge bg-light text-dark fw-medium px-3 py-2 rounded-pill shadow-sm">
                    <%= selectedDate.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </span>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-header-custom">
                        <tr>
                            <th scope="col" class="ps-4 py-3">เวลา</th>
                            <th scope="col" class="py-3">รายการเสินค้า</th>
                            <th scope="col" class="text-center py-3">วิธีชำระเงิน</th>
                            <th scope="col" class="text-end py-3">ส่วนลด</th>
                            <th scope="col" class="text-end py-3">ยอดสุทธิ</th>
                            <th scope="col" class="text-end pe-4 py-3">กำไร</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (sales && sales.length > 0) { %>
                            <% sales.forEach(s => { %>
                            <tr class="border-bottom border-opacity-10">
                                <td class="ps-4">
                                    <div class="fw-bold">
                                        <%= new Date(s.createdAt).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) %> น.
                                    </div>
                                    <div class="small opacity-50">#<%= s._id.toString().slice(-6).toUpperCase() %></div>
                                </td>
                                <td>
                                    <ul class="item-list">
                                        <% s.items.forEach(item => { %>
                                            <li><%= item.name %> <span class="fw-bold">x<%= item.qty %></span></li>
                                        <% }) %>
                                    </ul>
                                </td>
                                <td class="text-center">
                                    <% if(s.paymentMethod === 'cash') { %>
                                        <span class="payment-badge payment-cash"><i class="bi bi-cash me-1"></i> เงินสด</span>
                                    <% } else if(s.paymentMethod === 'transfer') { %>
                                        <span class="payment-badge payment-transfer"><i class="bi bi-bank me-1"></i> โอนเงิน</span>
                                    <% } else if(s.paymentMethod === 'promptpay') { %>
                                        <span class="payment-badge payment-promptpay"><i class="bi bi-qr-code-scan me-1"></i> พร้อมเพย์</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary"><%= s.paymentMethod %></span>
                                    <% } %>
                                </td>
                                <td class="text-end text-danger fw-medium">
                                    <%= s.discount > 0 ? '-฿' + Number(s.discount).toLocaleString() : '-' %>
                                </td>
                                <td class="text-end fw-bold">
                                    ฿<%= Number(s.total).toLocaleString(undefined, { minimumFractionDigits: 2 }) %>
                                </td>
                                <td class="text-end pe-4">
                                    <span class="badge-profit">
                                        +฿ <%= Number(s.profit).toLocaleString() %>
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <div class="mb-3 opacity-25"><i class="bi bi-inbox fs-1"></i></div>
                                    <h5>ไม่มีข้อมูลการขายสำหรับวันที่เลือก</h5>
                                    <p class="mb-0 small">ลองเลือกวันที่อื่น หรือทำรายการขายใหม่เพื่อดูผลลัพธ์</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>