<!-- Theme Script inside Navbar to ensure it loads on all pages -->
<style>
    #theme-toggle-btn { transition: transform 0.3s ease; }
    #theme-toggle-btn:active { transform: scale(0.9) rotate(15deg); }
    .navbar-brand { font-weight: 700; background: linear-gradient(135deg, var(--bs-primary), var(--bs-link-hover-color)); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
</style>
<script src="/js/theme.js"></script>
<nav class="navbar navbar-expand-lg glass-panel sticky-top" style="border-radius: 0; border-left: none; border-right: none; border-top: none; z-index: 1000;">
    <div class="container">
        <a class="navbar-brand" href="/">POS System</a>
        <ul class="navbar-nav ms-auto">
            <% if (user) { %>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <!-- เมนูซ้าย -->
                </ul>

                <span class="navbar-text ms-auto me-3 fw-medium">
                    👤 <%= user.name %> (<%= user.role %>)
                </span>

                <ul class="navbar-nav">
                    <!-- เมนูขวา เช่น Logout -->
                </ul>
            </div>

            <% if (user.role === 'owner') { %>
            <li class="nav-item"><a class="nav-link" href="/employees">Manage Employees</a></li>
            <li class="nav-item"><a class="nav-link" href="/members">Manage Members</a></li>
            <li class="nav-item"><a class="nav-link" href="/products">Manage Products</a></li>
            <li class="nav-item"><a class="nav-link" href="/sales">Sales History</a></li>
            <li class="nav-item"><a class="nav-link" href="/reports/daily">Daily Report</a></li>
            <% } %>

            <li class="nav-item">
                <button id="theme-toggle-btn" class="btn btn-outline-secondary ms-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; border-radius: 50%; padding: 0;" onclick="toggleTheme()" title="Toggle Theme">
                    <i class="bi bi-moon-fill"></i>
                </button>
            </li>
            <li class="nav-item ms-2"><a class="nav-link text-danger fw-bold" href="/auth/logout"><i class="bi bi-box-arrow-right"></i> ออกจากระบบ</a></li>
            <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
            <% } %>
        </ul>
    </div>
</nav>